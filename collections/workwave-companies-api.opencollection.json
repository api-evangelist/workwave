{
  "opencollection": "1.0.0",
  "info": {
    "name": "WorkWave Route Manager Callback Companies API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-WorkWave-Key",
      "value": "{{X-WorkWave-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Companies",
        "type": "folder"
      },
      "items": [
        {
          "info": {

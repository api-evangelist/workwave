            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://wwrm.workwave.com/api/v1/companies",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a company."
        },
        {
          "info": {
            "name": "Replace a company.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://wwrm.workwave.com/api/v1/companies/:companyId",
            "params": [
              {
                "name": "companyId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Replace a company."
        },
        {
          "info": {
            "name": "Delete a company.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://wwrm.workwave.com/api/v1/companies/:companyId",
            "params": [
              {
                "name": "companyId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a company."
        }
      ]
    }
  ],
  "bundled": true
}